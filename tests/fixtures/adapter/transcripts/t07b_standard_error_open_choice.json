    {"expect": {"jsonrpc": "2.0", "method": "adapter.requestChoice", "params": {"target_session": "alpha"}}, "capture_id_as": "c1", "capture_correlation_as": "cc1"},
    {"send": {"jsonrpc": "2.0", "id": "$c1", "error": {"code": -32600, "message": "Invalid Request"}}},
    {"expect": {"jsonrpc": "2.0", "id": "10", "result": {"outcome": "Submitted", "correlation_id": "c-stderr"}}}
  ]
