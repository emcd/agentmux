{
  "requirement": "Relay reads adapter output through a poll look RPC",
  "capability": "adapter-look-poll",
  "limit": null,
  "description": "Lines/offset windowing over a scripted three-entry snapshot: take-last-N with N greater than one, mid-range offsets, absent-lines, offset-past-end, and per-entry flag preservation across cuts. entries_total always counts the whole snapshot; returned_entries_count counts the window.",
  "adapter_script": "snapshots-three-entries.toml",
  "spawn": {"args": ["--target", "seat-1", "--script", "tests/fixtures/adapter/snapshots-three-entries.toml"], "env": {}},
  "bind": {
    "expect_hello_subset": {
      "adapter_profile": "generic",
      "target_session": "seat-1",
      "protocol_major": 2,
      "protocol_minor": 0
    },
    "hello_result": {
      "runtime_instance": "test-instance-1",
      "adapter_generation": 7,
      "selected_major": 2,
      "selected_minor": 0,
      "negotiated_limits": {
        "max_frame_bytes": 1048576,
        "queue_tx_bytes": 16777216,
        "queue_rx_bytes": 16777216,
        "max_control_pending": 32,
        "max_events_per_second": 100,
        "window_seconds": 1,
        "max_submits_in_flight": 64,
        "max_choices_in_flight": 16,
        "max_looks_in_flight": 8,
        "drain_wait_ms": 250
      },
      "snapshot_b64": ""
    },
    "hello_result_raw": null
  },
  "frames": [
    {"send": {"jsonrpc": "2.0", "id": "10", "method": "relay.look", "params": {"protocol_major": 2, "protocol_minor": 0, "runtime_instance": "test-instance-1", "target_session": "seat-1", "look_handle_id": "h-tail2", "adapter_generation": 7, "correlation_id": "c-tail2", "lines": 2, "offset": 0, "prime_timeout_ms": 0}}},
    {"expect": {"jsonrpc": "2.0", "id": "10", "result": {"correlation_id": "c-tail2", "entries": [{"kind": "text", "seq": 2, "text_b64": "c2Vjb25kIGxpbmU=", "truncated": true}, {"kind": "text", "seq": 3, "text_b64": "dGhpcmQgbGluZQ==", "truncated": false}], "entries_total": 3, "returned_entries_count": 2, "freshness": "fresh", "snapshot_source": "live", "stale": false, "discontinuity": false}}},
    {"send": {"jsonrpc": "2.0", "id": "11", "method": "relay.look", "params": {"protocol_major": 2, "protocol_minor": 0, "runtime_instance": "test-instance-1", "target_session": "seat-1", "look_handle_id": "h-mid", "adapter_generation": 7, "correlation_id": "c-mid", "lines": 2, "offset": 1, "prime_timeout_ms": 0}}},
    {"expect": {"jsonrpc": "2.0", "id": "11", "result": {"correlation_id": "c-mid", "entries": [{"kind": "text", "seq": 1, "text_b64": "Zmlyc3QgbGluZQ==", "truncated": false}, {"kind": "text", "seq": 2, "text_b64": "c2Vjb25kIGxpbmU=", "truncated": true}], "entries_total": 3, "returned_entries_count": 2, "freshness": "fresh"}}},
    {"send": {"jsonrpc": "2.0", "id": "12", "method": "relay.look", "params": {"protocol_major": 2, "protocol_minor": 0, "runtime_instance": "test-instance-1", "target_session": "seat-1", "look_handle_id": "h-absent", "adapter_generation": 7, "correlation_id": "c-absent", "offset": 2, "prime_timeout_ms": 0}}},
    {"expect": {"jsonrpc": "2.0", "id": "12", "result": {"correlation_id": "c-absent", "entries": [{"kind": "text", "seq": 1, "text_b64": "Zmlyc3QgbGluZQ==", "truncated": false}], "entries_total": 3, "returned_entries_count": 1}}},
    {"send": {"jsonrpc": "2.0", "id": "13", "method": "relay.look", "params": {"protocol_major": 2, "protocol_minor": 0, "runtime_instance": "test-instance-1", "target_session": "seat-1", "look_handle_id": "h-one", "adapter_generation": 7, "correlation_id": "c-one", "lines": 1, "offset": 2, "prime_timeout_ms": 0}}},
    {"expect": {"jsonrpc": "2.0", "id": "13", "result": {"correlation_id": "c-one", "entries": [{"kind": "text", "seq": 1, "text_b64": "Zmlyc3QgbGluZQ==", "truncated": false}], "entries_total": 3, "returned_entries_count": 1}}},
    {"send": {"jsonrpc": "2.0", "id": "14", "method": "relay.look", "params": {"protocol_major": 2, "protocol_minor": 0, "runtime_instance": "test-instance-1", "target_session": "seat-1", "look_handle_id": "h-past", "adapter_generation": 7, "correlation_id": "c-past", "lines": 2, "offset": 3, "prime_timeout_ms": 0}}},
    {"expect": {"jsonrpc": "2.0", "id": "14", "result": {"correlation_id": "c-past", "entries": [], "entries_total": 3, "returned_entries_count": 0}}}
  ]
}
